# Copy to .env before `npm start` (dotenv loads it automatically).
# See ../../README.md for how to create the agent and PGP keypair on saltapp.ai.

HOST=https://saltapp.ai
SALT_API_KEY=
SALT_APP_ID=
SALT_USERNAME=
# Armored PGP blocks, escaped to one line with literal "\n" -- the adapter
# unescapes this the same way salt-app-example's .env does.
APP_PUBLIC_KEY=
APP_PRIVATE_KEY=
PGP_PASSPHRASE=salt
PORT=5100
